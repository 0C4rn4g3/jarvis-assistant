# ============================================================
# Jarvis - environment configuration template
# ============================================================
# HOW TO USE:
#   On Windows: copy this file to  %APPDATA%\Jarvis\env
#               (that's usually C:\Users\<you>\AppData\Roaming\Jarvis\env)
#   Then fill in the values below. No quotes needed.
#
#   Alternatively, set these as real environment variables
#   before running Jarvis and they will take priority.
# ============================================================


# ── REQUIRED ─────────────────────────────────────────────────
# Your Google AI Studio API key. Free tier works for voice + agent.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── OPTIONAL: phone & Telegram ───────────────────────────────
# Relay URL for the Android app (set after deploying relay/worker.js to Cloudflare).
# Leave blank if you are not using the phone app.
# JARVIS_RELAY_URL=

# Telegram bot token (from @BotFather). Leave blank if not using Telegram.
# TELEGRAM_BOT_TOKEN=


# ── OPTIONAL: networking ──────────────────────────────────────
# Port the local app server listens on (default: 4849).
# Change only if something else is already using that port.
# JARVIS_HUD_PORT=4849


# ── OPTIONAL: custom / local AI backends ─────────────────────
# If you run a local model (Ollama, LM Studio, etc.) you can point
# Jarvis at it from the Models page in the app. No env var needed
# for that — this section is only if you prefer env-based config.
# See README.md → "Models" for the format.
